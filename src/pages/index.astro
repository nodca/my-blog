---
import { type CollectionEntry, getCollection } from "astro:content";
import dayjs from "@utils/dayjs";
import EditorialPostListItem from "@/components/EditorialPostListItem.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";

const posts = await getCollection("blog");
const recentPosts: CollectionEntry<"blog">[] = posts
  .sort(
    (a: CollectionEntry<"blog">, b: CollectionEntry<"blog">) =>
      new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime(),
  )
  .slice(0, 5);
const total = posts.length;
---

<BaseLayout title="首页 - 记录生活与技术的个人博客">
  <div class="pt-8 md:pt-16">
    <header class="swiss-grid gap-y-8 pb-16 md:pb-28">
      <div class="col-span-4 md:col-span-3">
        <p class="swiss-label text-pepper">Index</p>
        <p class="swiss-label mt-2 text-base-content/60">
          {total} 篇文章 · {dayjs().format("YYYY")}
        </p>
      </div>
      <div class="col-span-4 md:col-span-9">
        <h1
          class="text-[3.5rem] font-extrabold leading-[0.95] tracking-[-0.045em] text-base-content sm:text-7xl md:text-[7.5rem] lg:text-[9rem]"
        >
          Hello,<br />World<span class="text-pepper">.</span>
        </h1>
        <div class="mt-10 grid grid-cols-1 gap-6 md:grid-cols-9 md:gap-x-6">
          <p class="text-xl font-medium leading-snug md:col-span-5 md:text-2xl">
            记录技术探索和生活碎片。
          </p>
          <div class="flex items-start gap-6 text-base font-semibold md:col-span-4">
            <a href="/blog" class="border-b-2 border-pepper pb-1 hover:text-pepper">阅读文章 →</a>
            <a href="/about" class="border-b-2 border-transparent pb-1 text-base-content/60 hover:text-base-content">关于我</a>
          </div>
        </div>
      </div>
    </header>

    <section>
      <div class="swiss-grid items-end border-t-4 border-base-content pt-4 pb-2">
        <h2 class="col-span-3 text-sm font-bold uppercase tracking-[0.18em] md:col-span-3">
          最新发布
        </h2>
        <div class="col-span-1 text-right md:col-span-9">
          <a href="/blog" class="swiss-label text-base-content/60 hover:text-pepper">全部 →</a>
        </div>
      </div>

      <div class="border-b border-base-content">
        {
          recentPosts.map((post, i) => (
            <EditorialPostListItem
              href={`/blog/${post.slug}`}
              title={post.data.title}
              description={post.data.description}
              displayDate={dayjs(post.data.pubDate).format("YYYY.MM.DD")}
              category={post.data.categories?.[0]}
              headingTag="h3"
              index={i + 1}
            />
          ))
        }
      </div>
    </section>
  </div>
</BaseLayout>
