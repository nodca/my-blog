---
import { type CollectionEntry, getCollection } from "astro:content";
import dayjs from "@utils/dayjs";
import PosterHero from "@/components/PosterHero.astro";
import { groupOf, POST_GROUPS, type PostGroup } from "@/data/postGroups";
import BaseLayout from "@/layouts/BaseLayout.astro";

const posts: CollectionEntry<"blog">[] = (await getCollection("blog")).sort(
  (a, b) =>
    new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime(),
);

const order: PostGroup[] = [...POST_GROUPS, "其他"];
const groups = order
  .map((name) => ({
    name,
    posts: posts.filter((p) => groupOf(p.slug, p.data.tags) === name),
  }))
  .filter((g) => g.posts.length > 0);
---

<BaseLayout title="首页 - 记录生活与技术的个人博客" wide>
  <PosterHero
    title="nodca 的工作台"
    subtitle="写 Go 后端、训模型、做卡牌 Mod、自己托管一切"
  />

  <section aria-label="按主题浏览文章" class="flex flex-col gap-14">
    {
      groups.map((group) => (
        <div class="grid gap-4 md:grid-cols-[10rem_minmax(0,46rem)] md:gap-10">
          <h2 class="self-start bg-base-content px-3 py-2 text-lg font-bold text-base-100 md:sticky md:top-24">
            {group.name}
          </h2>
          <ul class="-mt-5">
            {group.posts.map((post) => (
              <li class="border-b border-base-content/20 py-5">
                <a href={`/blog/${post.slug}`} class="group block">
                  <h3 class="text-xl font-bold leading-snug underline decoration-transparent decoration-2 underline-offset-[0.25em] group-hover:decoration-accent md:text-[22px]">
                    {post.data.title}
                  </h3>
                  {post.data.description && (
                    <p class="mt-2 line-clamp-2 text-[15px] leading-relaxed text-[color:var(--faded-ink)]">
                      {post.data.description}
                    </p>
                  )}
                  <p class="mt-2 text-sm text-[color:var(--faded-ink)]">
                    <time datetime={post.data.pubDate.toISOString()}>
                      {dayjs(post.data.pubDate).format("YYYY 年 M 月 D 日")}
                    </time>
                  </p>
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
    <p class="md:pl-[12.5rem]">
      <a href="/blog" class="ink-link font-medium">按时间顺序看全部文章</a>
    </p>
  </section>
</BaseLayout>
