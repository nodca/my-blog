---
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout title="About">
  <article class="pt-8 md:pt-16 antialiased">
    <header class="swiss-grid gap-y-6 pb-12 md:pb-20">
      <div class="col-span-4 md:col-span-3">
        <p class="swiss-label text-pepper">About</p>
      </div>
      <div class="col-span-4 md:col-span-9">
        <h1 class="text-6xl font-extrabold leading-none tracking-[-0.04em] md:text-8xl">
          About Me<span class="text-pepper">.</span>
        </h1>
      </div>
    </header>

    <div class="swiss-grid border-t-4 border-base-content pt-10">
      <div class="col-span-4 md:col-span-3">
        <p class="swiss-label text-base-content/50">Status</p>
      </div>
      <div class="col-span-4 md:col-span-6">
        <p class="text-xl font-medium leading-relaxed md:text-2xl">
          I am still working on this page. More words and stories will fill this
          space soon.
        </p>
      </div>
    </div>
  </article>
</BaseLayout>
