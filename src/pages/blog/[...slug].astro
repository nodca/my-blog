---
import { Image } from "astro:assets";
import { type CollectionEntry, getCollection } from "astro:content";
import Comment from "@components/widgets/Comment.astro";
import License from "@components/widgets/License.astro";
import BaseLayout from "@layouts/BaseLayout.astro";
import dayjs from "@utils/dayjs";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((blog: { slug: any }) => ({
    params: { slug: blog.slug },
    props: { blog },
  }));
}
interface Props {
  blog: CollectionEntry<"blog">;
}

const { blog } = Astro.props;
const { Content, remarkPluginFrontmatter } = await blog.render();
const displayDate = blog.data.pubDate
  ? dayjs(blog.data.pubDate).format("YYYY.MM.DD")
  : "";
const url = new URL(`/blog/${blog.slug}`, Astro.url.origin);
---

<BaseLayout
  title={blog.data.title}
  description={blog.data.description}
>
  <article class="pt-8 md:pt-16 antialiased w-full">
    <header class="swiss-grid gap-y-6 pb-10 md:pb-16">
      <div class="col-span-4 md:col-span-3 flex flex-row flex-wrap gap-x-4 gap-y-1 md:flex-col md:pt-3">
        <time datetime={blog.data.pubDate.toISOString()} class="swiss-label tabular-nums text-pepper">
          {displayDate}
        </time>
        {blog.data.categories?.length > 0 && (
          <span class="swiss-label text-base-content/60">{blog.data.categories[0]}</span>
        )}
        {remarkPluginFrontmatter?.readingTime && (
          <span class="swiss-label text-base-content/60">{remarkPluginFrontmatter.readingTime}</span>
        )}
      </div>
      <div class="col-span-4 md:col-span-9">
        <h1 class="text-4xl font-extrabold leading-[1.05] tracking-[-0.035em] text-base-content sm:text-5xl md:text-6xl lg:text-7xl">
          {blog.data.title}
        </h1>
        {blog.data.description && (
          <p class="mt-6 max-w-2xl text-lg font-medium leading-relaxed text-base-content/65 md:text-xl">
            {blog.data.description}
          </p>
        )}
      </div>
    </header>

    <div class="border-t-4 border-base-content"></div>

    {blog.data.image && (
      <figure class="mt-10 swiss-grid">
        <div class="col-span-4 md:col-span-9 md:col-start-4">
          <Image
            src={blog.data.image}
            alt={blog.data.title}
            width={1200}
            height={630}
            class="w-full h-auto object-cover"
            loading="eager"
          />
        </div>
      </figure>
    )}

    <div class="swiss-grid mt-10 md:mt-14">
      <div class="col-span-4 md:col-span-9 md:col-start-4">
        <div
          id="content"
          class="prose swiss-prose max-w-[42rem] prose-headings:font-sans prose-img:w-full mb-20"
        >
          <Content />
        </div>
    <!-- Article Footer (Tags & License) -->
    <footer class="border-t border-base-content pt-8 mt-10">
      {blog.data.tags?.length > 0 && (
        <div class="flex flex-wrap gap-2 mb-10">
          <span class="swiss-label text-base-content/50 mr-2 self-center">Tags</span>
          {blog.data.tags.map((tag: string) => (
            <a href={`/blog/tags#${tag}`} class="swiss-label border border-base-content px-2 py-1 hover:border-pepper hover:bg-pepper hover:text-white">
              #{tag}
            </a>
          ))}
        </div>
      )}

      <License
        url={url}
        title={blog.data.title}
        image={blog.data.image}
        pubDate={blog.data.pubDate}
        badge={blog.data.badge}
        categories={blog.data.categories}
        tags={blog.data.tags}
        word={remarkPluginFrontmatter.totalCharCount}
        time={remarkPluginFrontmatter.readingTime}
      />
      
      <div class="mt-16">
        <Comment pageTitle={blog.data.title} />
      </div>
    </footer>
      </div>
    </div>
  </article>
</BaseLayout>
