---
import Pagination from "@components/widgets/Pagination.astro";
import { t } from "@config";
import type { Page, Post } from "@interfaces/data";
import BaseLayout from "@layouts/BaseLayout.astro";
import { generatePageLinks } from "@utils/blogUtils";
import dayjs from "@utils/dayjs";
import { getMainBlogPaginationPaths } from "@utils/paginationUtils";
import EditorialPostListItem from "@/components/EditorialPostListItem.astro";

export async function getStaticPaths({ paginate }: { paginate: any }) {
  return getMainBlogPaginationPaths({ paginate });
}

const { page }: { page: Page } = Astro.props;

const totalPages = Math.ceil(page.total / page.size);
const pageLinks = generatePageLinks(totalPages);
---

<BaseLayout title={t("nav.blog") || "Blog"}>
  <div class="pt-8 md:pt-16">
    <header class="swiss-grid gap-y-6 pb-12 md:pb-20">
      <div class="col-span-4 md:col-span-3">
        <p class="swiss-label text-pepper">Archive</p>
        <p class="swiss-label mt-2 text-base-content/60">
          {page.total} 篇 · 第 {page.current}/{totalPages} 页
        </p>
      </div>
      <div class="col-span-4 md:col-span-9">
        <h1 class="text-6xl font-extrabold leading-none tracking-[-0.04em] md:text-8xl">
          {t("nav.blog") || "Articles"}
        </h1>
        <nav class="mt-8 flex flex-wrap gap-x-6 gap-y-2 text-sm font-semibold">
          <a href="/blog/archives" class="hover:text-pepper">归档</a>
          <a href="/blog/categories" class="hover:text-pepper">分类</a>
          <a href="/blog/tags" class="hover:text-pepper">标签</a>
          <a href="/blog/search" class="hover:text-pepper">搜索</a>
        </nav>
      </div>
    </header>

    <div class="mb-16 border-b border-base-content">
      {
        page.data.map((blog: Post, i: number) => (
          <EditorialPostListItem
            href={`/blog/${blog.slug}`}
            title={blog.data.title}
            description={blog.data.description}
            displayDate={dayjs(blog.data.pubDate).format("YYYY.MM.DD")}
            category={blog.data.categories?.[0]}
            readingTime={blog.remarkPluginFrontmatter?.readingTime}
            index={(page.current - 1) * page.size + i + 1}
          />
        ))
      }
    </div>

    <div>
      <Pagination
        page={page}
        totalPages={totalPages}
        pageLinks={pageLinks}
        baseUrl={`/blog`}
      />
    </div>
  </div>
</BaseLayout>
