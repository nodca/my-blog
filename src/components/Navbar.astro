---
import { SITE_MENU, SITE_TITLE } from "../config";
import ThemeToggle from "./widgets/ThemeToggle.astro";

const currentPath = Astro.url.pathname;

type MenuItem = {
  id: string;
  text: string;
  href: string;
  svg: string;
  target?: string;
};

const navItems = (SITE_MENU as MenuItem[]).map((item) => ({
  text: item.text,
  href: item.href,
  target: item.target,
}));

const isActive = (href: string) =>
  href === "/" ? currentPath === "/" : currentPath.startsWith(href);
---

<header class="fixed top-0 left-0 right-0 z-50 bg-base-100 border-b border-base-content">
  <div
    class="mx-auto grid h-16 max-w-[1280px] grid-cols-4 items-center gap-x-4 px-5 sm:px-8 md:grid-cols-12 md:gap-x-6 lg:px-12"
  >
    <a
      href="/"
      class="col-span-2 flex items-center gap-3 md:col-span-3 text-base font-bold tracking-tight text-base-content hover:text-pepper"
    >
      <span class="block h-4 w-4 bg-pepper" aria-hidden="true"></span>
      {SITE_TITLE}
    </a>

    <nav class="hidden md:col-span-8 md:flex items-center gap-6 lg:gap-8 text-sm font-medium">
      {
        navItems.map((item) => (
          <a
            href={item.href}
            target={item.target || "_self"}
            class:list={[
              "border-b-2 py-1 transition-colors",
              isActive(item.href)
                ? "border-pepper text-base-content"
                : "border-transparent text-base-content/60 hover:text-base-content",
            ]}
          >
            {item.text}
          </a>
        ))
      }
    </nav>

    <div class="col-span-2 md:col-span-1 flex items-center justify-end gap-2">
      <a
        href="/blog/archives"
        class="md:hidden swiss-label text-base-content hover:text-pepper"
      >
        Menu
      </a>
      <ThemeToggle className="-mr-2" />
    </div>
  </div>
</header>
