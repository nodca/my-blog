---
interface Props {
  href: string;
  title: string;
  displayDate: string;
  description?: string;
  category?: string;
  readingTime?: string;
  headingTag?: "h2" | "h3";
  className?: string;
  index?: number;
}

const {
  href,
  title,
  displayDate,
  description,
  category,
  readingTime,
  headingTag = "h2",
  className = "",
  index,
} = Astro.props as Props;

const HeadingTag = headingTag;
const number =
  typeof index === "number" ? String(index).padStart(2, "0") : undefined;
---

<article class:list={["group border-t border-base-content", className]}>
  <a href={href} class="grid grid-cols-4 gap-x-4 gap-y-2 py-6 md:grid-cols-12 md:gap-x-6 md:py-8">
    <div class="col-span-4 flex items-baseline gap-4 md:col-span-3 md:flex-col md:gap-1">
      {
        number && (
          <span class="text-sm font-bold tabular-nums text-pepper">{number}</span>
        )
      }
      <time class="swiss-label tabular-nums text-base-content/60">{displayDate}</time>
      {
        category && (
          <span class="swiss-label text-base-content/60">{category}</span>
        )
      }
    </div>

    <div class="col-span-4 md:col-span-8">
      <HeadingTag
        class="text-2xl font-bold leading-tight tracking-tight text-base-content transition-colors group-hover:text-pepper md:text-[2rem]"
      >
        {title}
      </HeadingTag>
      {
        description && (
          <p class="mt-3 max-w-2xl text-base leading-relaxed text-base-content/65">
            {description}
          </p>
        )
      }
      {
        readingTime && (
          <p class="swiss-label mt-4 text-base-content/45">{readingTime}</p>
        )
      }
    </div>

    <div class="hidden md:col-span-1 md:flex md:justify-end">
      <span
        class="text-2xl leading-none text-base-content/30 transition-colors group-hover:text-pepper"
        aria-hidden="true">→</span
      >
    </div>
  </a>
</article>
