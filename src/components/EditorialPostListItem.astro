---
interface Props {
  href: string;
  title: string;
  displayDate: string;
  description?: string;
  category?: string;
  readingTime?: string;
  headingTag?: "h2" | "h3";
  className?: string;
}

const {
  href,
  title,
  displayDate,
  description,
  category,
  readingTime,
  headingTag = "h2",
  className = "",
} = Astro.props as Props;

const HeadingTag = headingTag;
---

<article class:list={["group py-5 border-b border-base-content/20", className]}>
  <a href={href} class="block">
    <HeadingTag
      class="text-xl md:text-[22px] font-bold leading-snug text-base-content underline decoration-transparent decoration-2 underline-offset-[0.25em] group-hover:decoration-accent"
    >
      {title}
    </HeadingTag>
    {
      description && (
        <p class="mt-2 text-[15px] leading-relaxed text-[color:var(--faded-ink)] line-clamp-2">
          {description}
        </p>
      )
    }
    <p class="mt-2 text-sm text-[color:var(--faded-ink)]">
      <time>{displayDate}</time>{category && <span>，{category}</span>}{readingTime && <span>，约 {readingTime} 分钟</span>}
    </p>
  </a>
</article>
