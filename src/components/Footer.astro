---
import { USER_FOOTER_SOCIAL_ICONS, USER_NAME, USER_SITE } from "@config";
import { Icon } from "astro-icon/components";
---

<footer class="flex flex-col gap-4 border-t-2 border-base-content pt-6 text-sm text-[color:var(--faded-ink)] sm:flex-row sm:items-center sm:justify-between">
  <p>
    © {new Date().getFullYear()} <a href={USER_SITE} class="ink-link text-base-content">{USER_NAME}</a>，基于
    <a href="https://github.com/EveSunMaple/Frosti" target="_blank" class="ink-link">Frosti</a> 主题改造。
  </p>
  <nav class="flex items-center gap-4" aria-label="社交链接">
    {
      USER_FOOTER_SOCIAL_ICONS.map((icon) => (
        <a href={icon.href} aria-label={icon.ariaLabel} title={icon.title} class="text-base-content hover:text-accent">
          <Icon name={icon.svg} class="text-xl" />
        </a>
      ))
    }
    <a href="/rss.xml" aria-label="RSS 订阅" title="RSS 订阅" class="text-base-content hover:text-accent">
      <Icon name="ri:rss-line" class="text-xl" />
    </a>
  </nav>
</footer>
