---
import { USER_FOOTER_SOCIAL_ICONS, USER_NAME, USER_SITE } from "@config";
---

<footer class="mt-8 border-t border-base-content bg-base-100">
  <div
    class="mx-auto grid max-w-[1280px] grid-cols-4 gap-x-4 gap-y-8 px-5 py-10 sm:px-8 md:grid-cols-12 md:gap-x-6 lg:px-12"
  >
    <div class="col-span-4 md:col-span-6">
      <p class="text-2xl font-bold tracking-tight">
        <a href={USER_SITE} target="_blank" class="hover:text-pepper">{USER_NAME}</a>
      </p>
      <p class="mt-2 text-sm text-base-content/60">
        © {new Date().getFullYear()} {USER_NAME}. All rights reserved.
      </p>
    </div>

    <div class="col-span-2 md:col-span-3">
      <p class="swiss-label mb-3 text-base-content/50">Social</p>
      <ul class="space-y-1 text-sm font-medium">
        {
          USER_FOOTER_SOCIAL_ICONS.map((icon) => (
            <li>
              <a href={icon.href} aria-label={icon.ariaLabel} class="hover:text-pepper">
                {icon.title} ↗
              </a>
            </li>
          ))
        }
        <li>
          <a href="/rss.xml" aria-label="RSS Feed" class="hover:text-pepper">RSS ↗</a>
        </li>
      </ul>
    </div>

    <div class="col-span-2 md:col-span-3">
      <p class="swiss-label mb-3 text-base-content/50">Colophon</p>
      <p class="text-sm text-base-content/70">
        Powered by
        <a
          href="https://github.com/EveSunMaple/Frosti"
          target="_blank"
          class="underline decoration-pepper underline-offset-4 hover:text-pepper">Frosti</a
        >.
        <br />Set in Inter &amp; system sans.
      </p>
    </div>
  </div>
</footer>
